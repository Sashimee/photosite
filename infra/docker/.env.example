POSTGRES_USER=photoo
POSTGRES_PASSWORD=photoo_dev_password
POSTGRES_DB=photoo
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=photoo_dev
MINIO_ROOT_PASSWORD=photoo_dev_password
# Scoped backup/prune users for infra/dokploy/backup/*.sh and the restore
# drill in docs/runbooks/restore.md; minio-init defaults to these, so they
# only need setting to override them.
MINIO_BACKUP_ACCESS_KEY=photoo-backup-dev
MINIO_BACKUP_SECRET_KEY=photoo-backup-dev-secret
MINIO_PRUNE_ACCESS_KEY=photoo-prune-dev
MINIO_PRUNE_SECRET_KEY=photoo-prune-dev-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

CLAMAV_PORT=3310
