# Preview environment (footoo.bas.lu) variables for infra/dokploy/preview/compose.yml.
# Copy this file to `.env` in the Dokploy project (or paste each value into
# Dokploy's environment editor) - never commit the real `.env`.
# See infra/dokploy/preview/README.md for how to generate/set each secret.

# `main`, or a `sha-<short>` tag to pin/roll back (README.md "Rollback").
IMAGE_TAG=main

PREVIEW_HOST=footoo.bas.lu

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=photoo
POSTGRES_PASSWORD=
POSTGRES_DB=photoo

# --- MinIO (S3-compatible; stands in for the real EU bucket until it exists) -
# Root: only `minio` and `minio-init` ever see these (README.md "Object
# storage users").
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Scoped users minio-init creates for api/worker; generate access/secret
# keys the same way as the root pair (e.g. `openssl rand -hex 20` /
# `openssl rand -base64 32`).
MINIO_API_ACCESS_KEY=
MINIO_API_SECRET_KEY=
MINIO_WORKER_ACCESS_KEY=
MINIO_WORKER_SECRET_KEY=
# Scoped users for `backup` (README.md "Backups"): one can only write and
# list, the other can only delete under the backup prefix. Generate the
# same way as the other MinIO keys above.
MINIO_BACKUP_ACCESS_KEY=
MINIO_BACKUP_SECRET_KEY=
MINIO_PRUNE_ACCESS_KEY=
MINIO_PRUNE_SECRET_KEY=

# --- Redis ----------------------------------------------------------------
# openssl rand -base64 24
REDIS_PASSWORD=

# --- API auth (Better Auth) ----------------------------------------------
# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 32 (must decode to exactly 32 bytes)
AUTH_ENCRYPTION_KEY=

# --- Photographer verification (VerificationCase PII, api and seed) -------
# openssl rand -base64 32 (must decode to exactly 32 bytes). Must be the same
# value on both the api and seed services (README.md "Seed"), or the api
# can't decrypt what the seed encrypted.
VERIFICATION_ENCRYPTION_KEY=

# --- Backups (README.md "Backups") ---------------------------------------
# age public key (age1...) from `age-keygen`, run locally - the private key
# must never touch this server (docs/steps/human-followups.md). Until this
# is set, the `backup` service refuses to run rather than writing a
# plaintext dump.
BACKUP_AGE_RECIPIENT=

# --- OAuth (optional; each provider activates once both its vars are set) -
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- web build-time values (also read at runtime; see deploy-preview.yml) -
# Not secrets - end up in the client bundle either way. Set as GitHub
# repository variables with the same values as here.
NEXT_PUBLIC_API_URL=https://footoo.bas.lu
NEXT_PUBLIC_SITE_URL=https://footoo.bas.lu
NEXT_PUBLIC_MEDIA_BASE_URL=https://footoo.bas.lu/photoo-public
NEXT_PUBLIC_ALLOW_INDEXING=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_REQUIRED=false

# --- optional ---------------------------------------------------------
# Leave unset to use compose.yml's default (trusts dokploy-network's private
# ranges so per-IP rate limits work behind Traefik; README.md "Rate limiting").
TRUSTED_PROXIES=
# Only used by `--profile seed run --rm seed` (README.md "Seed").
SEED_USER_PASSWORD=
# Push notifications work without it (README.md "Email"); set once the Expo
# account exists (docs/steps/human-followups.md).
EXPO_ACCESS_TOKEN=
