{
  "name": "@photoo/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "i18n:check": "tsc -p tsconfig.build.json && node dist/scripts/check.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.19",
    "@photoo/shared": "workspace:*"
  },
  "devDependencies": {
    "@photoo/config": "workspace:*",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
