generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, citext]
}

enum Locale {
  en
  fr
  de
  pt
  es
}

enum UserRole {
  client
  photographer
  professional
  admin
}

enum UserStatus {
  active
  suspended
  deleted
}

enum DevicePlatform {
  ios
  android
  web
}

enum ConsentPurpose {
  analytics
  ads
  marketing
}

enum AuditActorType {
  user
  admin
  system
}

enum NotificationChannel {
  email
  push
  in_app
}

enum UploadPurpose {
  portfolio
  avatar
  cover
  logo
  chat_attachment
  verification_document
  delivery_file
}

enum UploadStatus {
  pending_upload
  uploaded
  scanning
  clean
  infected
  failed
  processed
}

enum VirusScanStatus {
  pending
  clean
  infected
  failed
}

enum PhotographerCategory {
  wedding
  portrait
  event
  product
  real_estate @map("real-estate")
  corporate
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum VerificationCaseStatus {
  draft
  submitted
  in_review
  approved
  rejected
  expired
}

enum PortfolioImageStatus {
  processing
  pending_review
  approved
  flagged
  rejected
}

enum ProvenanceVerdict {
  pass
  review
  fail
}

enum LicenceUsage {
  personal
  commercial
  editorial
  extended
}

enum RequestStatus {
  open
  quoted
  booked
  closed
  cancelled
}

enum QuoteStatus {
  draft
  sent
  accepted
  declined
  expired
  withdrawn
}

enum ConversationType {
  request
  quote
  booking
  direct
}

// Mirrors `ADMIN_PERMISSIONS` in packages/shared/src/enums.ts.
enum AdminPermission {
  support
  moderation
  verification
  finance
  superadmin
}

// Mirrors the inline `REPORT_STATUSES` in
// packages/shared/src/contract/admin.ts.
enum ReportStatus {
  open
  resolved
  dismissed
}

enum DataRequestType {
  export
  delete
}

enum DataRequestChannel {
  in_app
  email
  support
}

// `ready`/`cancelled` are required by docs/steps/1A.12-gdpr.md's "Export job
// shape" and "Deletion is immediate" decisions: a finished export sits at
// `ready` until downloaded or swept, and a deletion cancelled during its
// grace period is a terminal state of its own, not a failure.
// `DATA_REQUEST_STATUSES` in packages/shared/src/enums.ts predates that plan
// and lists only four; #197 tracks bringing it back in line.
enum DataRequestStatus {
  pending
  processing
  ready
  completed
  failed
  cancelled
}

enum BookingStatus {
  pending_payment
  paid_held
  in_progress
  delivered
  released
  refunded
  disputed
  cancelled
}

enum LedgerEntryType {
  charge
  platform_fee
  transfer
  refund
  reversal
  payout
}

// Our own simplified dispute lifecycle, not Stripe's full `dispute.status`
// enum. Mirrors `DISPUTE_STATUSES` in packages/shared/src/enums.ts.
enum DisputeStatus {
  open
  won
  lost
}

// Mirrors `JOB_OFFER_STATUSES` in packages/shared/src/enums.ts. Driven by
// the offer's listing lifecycle (docs/steps/1A.13-professionals.md):
// `published` while its listing is unexpired, `expired` once it lapses,
// `closed` when the professional closes it, `draft` before first publish.
enum JobOfferStatus {
  draft
  published
  closed
  expired
}

// Mirrors `JOB_APPLICATION_STATUSES`. The professional moves an application
// forward; the photographer may only withdraw.
enum JobApplicationStatus {
  submitted
  shortlisted
  rejected
  withdrawn
}

// Mirrors `LISTING_KINDS`. Polymorphic owner (`Listing.ownerId`, no foreign
// key): `job_offer` today, `featured_profile` from Phase 3.
enum ListingKind {
  job_offer
  featured_profile
}

// Mirrors `LISTING_PLANS`. Free forever at launch (D8); `paid`/`featured`
// switch on in Phase 3 without a schema change. The service refuses
// anything but `free` in Phase 1.
enum ListingPlan {
  free
  paid
  featured
}

model Country {
  code              String   @id @db.Char(2)
  name              String
  enabled           Boolean  @default(true)
  currency          String   @db.Char(3)
  vatRate           Decimal  @db.Decimal(5, 2)
  requiredDocuments Json
  legalTexts        Json
  defaultLocale     String
  timezone          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users                User[]
  photographerProfiles PhotographerProfile[]
  requests             Request[]
  verificationCases    VerificationCase[]
  jobOffers            JobOffer[]
}

model PlatformSetting {
  key              String   @id
  value            Json
  updatedByAdminId String?
  updatedByAdmin   User?    @relation(fields: [updatedByAdminId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([updatedByAdminId])
}

// Shape driven by Better Auth 1.7 (D20); see docs/steps/1A.1-identity-schema.md
// "Field mapping" for how each column corresponds to the library's schema.
model User {
  id               String     @id @default(uuid(7))
  email            String     @unique @db.Citext
  emailVerifiedAt  DateTime?
  name             String?
  locale           Locale
  countryCode      String     @db.Char(2)
  country          Country    @relation(fields: [countryCode], references: [code])
  roles            UserRole[]
  status           UserStatus @default(active)
  twoFactorEnabled Boolean    @default(false)
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  accounts                  Account[]
  sessions                  Session[]
  twoFactors                TwoFactor[]
  devices                   Device[]
  consentRecords            ConsentRecord[]
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  updatedPlatformSettings   PlatformSetting[]
  uploads                   Upload[]
  photographerProfile       PhotographerProfile?
  professionalProfile       ProfessionalProfile?
  requests                  Request[]
  quotes                    Quote[]
  conversationParticipants  ConversationParticipant[]
  sentMessages              Message[]
  verificationCases         VerificationCase[]        @relation("VerificationCaseUser")
  assignedVerificationCases VerificationCase[]        @relation("VerificationCaseAssignedAdmin")
  decidedVerificationCases  VerificationCase[]        @relation("VerificationCaseDecidedByAdmin")
  adminPermissionGrants     AdminPermissionGrant[]    @relation("AdminPermissionGrantUser")
  grantedPermissionGrants   AdminPermissionGrant[]    @relation("AdminPermissionGrantGrantedBy")
  reports                   Report[]                  @relation("ReportReporter")
  resolvedReports           Report[]                  @relation("ReportResolvedByAdmin")
  bookings                  Booking[]
  disputesOpened            Dispute[]                 @relation("DisputeOpenedBy")
  resolvedDisputes          Dispute[]                 @relation("DisputeAdmin")
  dataRequests              DataRequest[]
  reviewedProvenanceChecks  ProvenanceCheck[]         @relation("ProvenanceCheckReviewedByAdmin")

  @@index([countryCode])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt, id])
}

// Better Auth "account" table: OAuth links and the credential (email+password)
// row, where `password` holds the Argon2id hash written by the 1A.2 wrapper.
model Account {
  id                    String    @id @default(uuid(7))
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Better Auth "session" table. `token` is renamed to `tokenHash`: the 1A.2
// adapter wrapper hashes it (SHA-256) on write and lookup per SECURITY.md.
// `twoFactorVerifiedAt` has no better-auth counterpart (not a rename of a
// library field, so no `session.fields` mapping needed): it is set by the
// two-factor verify step for this session's id and read by
// `requireAdminSession` to require a *recently* verified second factor
// rather than merely `User.twoFactorEnabled`, superseding the note in
// `require-admin.ts`. Null means the second factor was never verified in
// this session.
model Session {
  id                  String    @id @default(uuid(7))
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  userAgent           String?
  ip                  String?
  expiresAt           DateTime
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// Better Auth "verification" table (email verification / password reset
// tokens). `value` is stored as issued by the library; see the "Field
// mapping" note in the subplan about hashing it at rest in 1A.2.
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth two-factor plugin's "twoFactor" table. `secret` is the TOTP
// seed; encryption-at-rest for it lands in 1A.2.
model TwoFactor {
  id                      String    @id @default(uuid(7))
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
}

model Device {
  id            String         @id @default(uuid(7))
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken String         @unique
  platform      DevicePlatform
  lastSeenAt    DateTime
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}

// A join table rather than a `String[]` column on `User`, because every
// grant is an auditable event and a revoke must say who did it and when
// (docs/steps/1A.11-admin-api.md): `grantedByAdminId`/`grantedAt` record the
// grant, and the grant/revoke event itself is written to `AuditLog` by the
// API service. Revoking a permission deletes the row (no `revokedAt`); the
// unique constraint means re-granting after a revoke is just a new row. A
// `User` with `admin` in `roles` and no grants can sign in and see nothing —
// the correct default for a freshly created admin. `superadmin` is the only
// permission that can grant permissions, and never for the granter's own
// account, both enforced by the API service, not this table.
model AdminPermissionGrant {
  id               String          @id @default(uuid(7))
  userId           String
  user             User            @relation("AdminPermissionGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  permission       AdminPermission
  grantedByAdminId String
  grantedByAdmin   User            @relation("AdminPermissionGrantGrantedBy", fields: [grantedByAdminId], references: [id], onDelete: Restrict)
  grantedAt        DateTime        @default(now())

  @@unique([userId, permission])
  @@index([permission])
  @@index([grantedByAdminId])
}

// Append-only: no updatedAt, no update paths in seed code. A hand-written
// CHECK constraint enforces exactly one of userId/anonymousId being set.
model ConsentRecord {
  id            String         @id @default(uuid(7))
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  anonymousId   String?
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String
  ip            String?
  userAgent     String?
  recordedAt    DateTime       @default(now())

  @@index([userId])
  @@index([anonymousId])
}

// Append-only: no updatedAt, no update paths in seed code. `actorId` is not
// a foreign key so entries survive even if the actor's User row is gone.
// Revoking UPDATE/DELETE at the database level is out of scope; see 1A.14.
model AuditLog {
  id         String         @id @default(uuid(7))
  actorType  AuditActorType
  actorId    String?
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  occurredAt DateTime       @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([occurredAt])
}

// DSA notice-and-action (docs/steps/1A.11-admin-api.md). `reporterId` is
// nullable so a signed-out visitor can report; `targetType`/`targetId` are
// polymorphic like `AuditLog.targetType`/`targetId`, no foreign key. Takedown
// itself is a status change on the target (never a delete) recorded outside
// this table; `status`/`adminId`/`resolution` here only track the report's
// own lifecycle, never updated after creation except by the resolve action.
model Report {
  id         String       @id @default(uuid(7))
  reporterId String?
  reporter   User?        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType String
  targetId   String
  reason     String
  status     ReportStatus @default(open)
  adminId    String?
  admin      User?        @relation("ReportResolvedByAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  resolution String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// `emailSentAt`/`pushSentAt` are set by the worker's per-channel processor
// once delivered, so a retry on the `notify` job never double-sends. The
// `notify-sweep` job re-enqueues rows still pending a wanted channel past
// its window; see the partial index note in DATA-MODEL.md.
model Notification {
  id          String                @id @default(uuid(7))
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  payload     Json
  channels    NotificationChannel[]
  emailSentAt DateTime?
  pushSentAt  DateTime?
  readAt      DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// A missing row for a `(userId, type, channel)` means the default: on.
// `in_app` can't be disabled (enforced by the API, not here).
model NotificationPreference {
  id        String              @id @default(uuid(7))
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  channel   NotificationChannel
  enabled   Boolean
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, type, channel])
}

// docs/steps/1A.12-gdpr.md. `status` is the source of truth for the export
// worker and the `gdpr-sweep` queue, never re-derived from `completedAt`/
// `cancelledAt` alone. `exportKey`/`expiresAt` are only ever set for a
// `type = export` row once it reaches `ready`; `failureReason` is a stable
// code, never a stack trace. `cancelledAt` is set by the cancel endpoint
// during a deletion's 30-day grace period. A hand-written partial unique
// index (Prisma has no declarative partial index support, like
// `VerificationCase`) enforces at most one `pending`/`processing` request
// per `(userId, type)`, so a second export or delete call while one is
// already in flight returns the existing row instead of racing a new one.
model DataRequest {
  id            String             @id @default(uuid(7))
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          DataRequestType
  status        DataRequestStatus  @default(pending)
  channel       DataRequestChannel @default(in_app)
  requestedAt   DateTime           @default(now())
  receivedAt    DateTime           @default(now())
  completedAt   DateTime?
  exportKey     String?
  expiresAt     DateTime?
  failureReason String?
  cancelledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([status, requestedAt])
  @@index([requestedAt(sort: Desc), id(sort: Desc)])
}

// Generic upload record referenced by id from Attachment, VerificationDocument,
// PortfolioImage and Delivery once 1A.3b lands. `objectKey` and `exif` are
// private (SECURITY.md) and never serialised to clients; downloads are only
// issued once `virusScanStatus = clean`. Uploads still `pending_upload` or
// `uploaded` past `expiresAt` are removed by the worker's cleanup job.
// `width`/`height` are set by the worker's image-process job once the
// upload is processed.
model Upload {
  id                String          @id @default(uuid(7))
  ownerId           String
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  purpose           UploadPurpose
  status            UploadStatus    @default(pending_upload)
  mimeType          String
  declaredSizeBytes Int
  actualSizeBytes   Int?
  width             Int?
  height            Int?
  objectKey         String          @unique
  variants          Json?
  exif              Json?
  virusScanStatus   VirusScanStatus @default(pending)
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  avatarForProfile     PhotographerProfile?  @relation("PhotographerProfileAvatar")
  coverForProfile      PhotographerProfile?  @relation("PhotographerProfileCover")
  portfolioImage       PortfolioImage?
  messageAttachment    MessageAttachment?
  verificationDocument VerificationDocument?
  deliveryFile         DeliveryFile?
  logoForProfile       ProfessionalProfile?  @relation("ProfessionalProfileLogo")

  @@index([ownerId])
  @@index([status])
  @@index([status, expiresAt])
}

// `location` is `geography(Point, 4326)`, an `Unsupported` type Prisma
// cannot index or write directly: the GiST index lives in hand-written
// migration SQL and `location` is only ever set/read via raw queries.
// `isPublished` requires `verificationStatus = verified` and
// `stripePayoutsEnabled = true` (DATA-MODEL.md); enforced by callers, not
// the database, since real profiles cannot flip either flag before 1A.8/1A.9.
model PhotographerProfile {
  id                       String                                 @id @default(uuid(7))
  userId                   String                                 @unique
  user                     User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                     String                                 @unique
  displayName              String
  headline                 String?
  bio                      Json
  avatarUploadId           String?                                @unique
  avatarUpload             Upload?                                @relation("PhotographerProfileAvatar", fields: [avatarUploadId], references: [id], onDelete: SetNull)
  coverUploadId            String?                                @unique
  coverUpload              Upload?                                @relation("PhotographerProfileCover", fields: [coverUploadId], references: [id], onDelete: SetNull)
  links                    Json
  categories               PhotographerCategory[]
  languages                String[]
  location                 Unsupported("geography(Point, 4326)")?
  serviceRadiusKm          Int?
  city                     String
  countryCode              String                                 @db.Char(2)
  country                  Country                                @relation(fields: [countryCode], references: [code])
  verificationStatus       VerificationStatus                     @default(unverified)
  stripeAccountId          String?
  stripeOnboardingComplete Boolean                                @default(false)
  stripePayoutsEnabled     Boolean                                @default(false)
  ratingAvg                Decimal                                @default(0) @db.Decimal(3, 2)
  ratingCount              Int                                    @default(0)
  isPublished              Boolean                                @default(false)
  deletedAt                DateTime?
  createdAt                DateTime                               @default(now())
  updatedAt                DateTime                               @updatedAt

  portfolioImages PortfolioImage[]
  products        Product[]
  quotes          Quote[]
  bookings        Booking[]
  jobApplications JobApplication[]

  @@index([countryCode])
  @@index([verificationStatus])
  @@index([city])
}

// `width`/`height` are copied from `Upload` once the worker's image-process
// job finishes, so the public profile response never has to join `Upload`.
model PortfolioImage {
  id        String               @id @default(uuid(7))
  profileId String
  profile   PhotographerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  uploadId  String               @unique
  upload    Upload               @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  width     Int?
  height    Int?
  order     Int
  status    PortfolioImageStatus @default(processing)
  deletedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  provenanceCheck ProvenanceCheck?

  @@index([profileId])
  @@index([status])
}

// One check row per `PortfolioImage`, written by the `provenance-check` worker
// queue (docs/steps/1A.10-provenance.md). `aiScore`/`aiVendor`/`reverseMatches`
// and `c2paValid` are individually nullable because a null vendor/reader
// records "no signal" rather than a clean result; `score`/`verdict` are always
// computed by `computeProvenanceScore` from whatever signals are available.
// `raw` holds the vendor payload and is cleared by the retention sweep after
// 90 days for a passed check, so it stays nullable even after being set.
model ProvenanceCheck {
  id                String            @id @default(uuid(7))
  portfolioImageId  String            @unique
  portfolioImage    PortfolioImage    @relation(fields: [portfolioImageId], references: [id], onDelete: Cascade)
  aiScore           Decimal?          @db.Decimal(4, 3)
  aiVendor          String
  reverseMatches    Json
  c2paValid         Boolean?
  exifCamera        String?
  exifCapturedAt    DateTime?
  score             Decimal           @db.Decimal(4, 3)
  verdict           ProvenanceVerdict
  reviewedByAdminId String?
  reviewedByAdmin   User?             @relation("ProvenanceCheckReviewedByAdmin", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  note              String?
  raw               Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([verdict, createdAt])
}

model Product {
  id              String               @id @default(uuid(7))
  profileId       String
  profile         PhotographerProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title           Json
  description     Json?
  category        PhotographerCategory
  durationMinutes Int
  deliverables    Json
  basePriceCents  Int
  currency        String               @db.Char(3)
  isActive        Boolean              @default(true)
  order           Int
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tiers  ProductTier[]
  quotes Quote[]

  @@index([profileId])
  @@index([isActive])
}

model ProductTier {
  id                 String       @id @default(uuid(7))
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  usage              LicenceUsage
  priceCents         Int
  currency           String       @db.Char(3)
  description        String?
  licenceTextVersion String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  quotes Quote[]

  @@unique([productId, usage])
  @@index([productId])
}

// `businessName`, `vatNumber` and `businessRegistrationNumber` are AES-256-GCM
// ciphertext written by the API's crypto helper (`VERIFICATION_ENCRYPTION_KEY`,
// separate from `AUTH_ENCRYPTION_KEY` so the two rotate independently); never
// plaintext, never queried. The partial unique index enforcing at most one
// active case (`draft`, `submitted` or `in_review`) per `userId` lives in
// hand-written migration SQL, like the Quote `sent`-status partial index.
model VerificationCase {
  id                         String                 @id @default(uuid(7))
  userId                     String
  user                       User                   @relation("VerificationCaseUser", fields: [userId], references: [id], onDelete: Cascade)
  countryCode                String                 @db.Char(2)
  country                    Country                @relation(fields: [countryCode], references: [code])
  status                     VerificationCaseStatus @default(draft)
  businessName               String?
  vatNumber                  String?
  businessRegistrationNumber String?
  submittedAt                DateTime?
  decidedAt                  DateTime?
  assignedAdminId            String?
  assignedAdmin              User?                  @relation("VerificationCaseAssignedAdmin", fields: [assignedAdminId], references: [id])
  decidedByAdminId           String?
  decidedByAdmin             User?                  @relation("VerificationCaseDecidedByAdmin", fields: [decidedByAdminId], references: [id])
  rejectionReason            String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  documents VerificationDocument[]

  @@index([userId])
  @@index([countryCode])
  @@index([status])
  @@index([assignedAdminId])
  @@index([decidedByAdminId])
}

// Mirrors `MessageAttachment`: `uploadId` is unique (an upload attaches to at
// most one verification document) and `Restrict` so a document can't be
// deleted out from under a submitted case. `mimeType`, `actualSizeBytes` and
// `virusScanStatus` are read from `Upload`, not duplicated (DATA-MODEL.md).
// Re-attaching the same `documentKey` while the case is `draft` replaces the
// row (delete then create) instead of updating it, so the unique constraint
// below never blocks that flow.
model VerificationDocument {
  id          String           @id @default(uuid(7))
  caseId      String
  case        VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  documentKey String
  uploadId    String           @unique
  upload      Upload           @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([caseId, documentKey])
  @@index([caseId])
}

// `location` is `geography(Point, 4326)`, an `Unsupported` type Prisma
// cannot index or write directly: the GiST index and the partial index on
// `(status, expiresAt)` live in hand-written migration SQL. `address` holds
// the full structured address and is visible only to the owning client and
// the booked photographer (DATA-MODEL.md).
model Request {
  id             String                                 @id @default(uuid(7))
  clientId       String
  client         User                                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title          String
  category       PhotographerCategory
  description    String
  eventDate      DateTime
  dateFlexible   Boolean                                @default(false)
  location       Unsupported("geography(Point, 4326)")?
  address        Json
  city           String
  countryCode    String                                 @db.Char(2)
  country        Country                                @relation(fields: [countryCode], references: [code])
  budgetMinCents Int
  budgetMaxCents Int
  currency       String                                 @db.Char(3)
  usage          LicenceUsage
  status         RequestStatus                          @default(open)
  expiresAt      DateTime
  deletedAt      DateTime?
  createdAt      DateTime                               @default(now())
  updatedAt      DateTime                               @updatedAt

  quotes Quote[]

  @@index([clientId, createdAt])
  @@index([countryCode])
}

// `photographerId` references `PhotographerProfile`, not `User` directly
// (DATA-MODEL.md), so a quote survives a photographer's profile identity
// (slug, display name) changing shape. `feePercent` is a snapshot of
// `PlatformSetting('feePercent')` at creation time so later fee changes
// never rewrite sent quotes; it is stored with the same precision as
// `Country.vatRate`. `licenceUsage`/`licenceTextVersion` snapshot the licence
// terms the client agreed to, because `productTierId` update
// (products.service.ts) hard-deletes and recreates tiers, which would
// otherwise silently null out and lose the original licence. The partial
// unique index on `(requestId, photographerId) WHERE status = 'sent'` and
// the CHECK constraints live in hand-written migration SQL.
model Quote {
  id                 String              @id @default(uuid(7))
  requestId          String?
  request            Request?            @relation(fields: [requestId], references: [id], onDelete: Restrict)
  photographerId     String
  photographer       PhotographerProfile @relation(fields: [photographerId], references: [id], onDelete: Restrict)
  clientId           String
  client             User                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  productId          String?
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTierId      String?
  productTier        ProductTier?        @relation(fields: [productTierId], references: [id], onDelete: SetNull)
  lineItems          Json
  subtotalCents      Int
  platformFeeCents   Int
  totalCents         Int
  feePercent         Decimal             @db.Decimal(5, 2)
  licenceUsage       LicenceUsage
  licenceTextVersion String?
  currency           String              @db.Char(3)
  validUntil         DateTime
  message            String?
  status             QuoteStatus         @default(sent)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  booking Booking?

  @@index([requestId])
  @@index([clientId, createdAt])
  @@index([photographerId, createdAt])
  @@index([status, validUntil])
  @@index([productId])
  @@index([productTierId])
}

// `subjectId` is the id of the request/quote/booking the conversation is
// about (polymorphic on `type`, so no foreign key), null for `direct`. The
// unique `(type, subjectId)` index makes creating the quote conversation
// idempotent (docs/steps/1A.6-chat.md): the same transaction that creates a
// quote can call `create` and rely on the database to reject a duplicate.
// `request` and `direct` aren't creatable in the MVP; `booking` reuses the
// quote's conversation rather than creating a new row.
model Conversation {
  id            String           @id @default(uuid(7))
  type          ConversationType
  subjectId     String?
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([type, subjectId])
}

// Replaces `Conversation.participantIds[]`, `Conversation.archivedBy[]` and
// `Message.readBy` (DATA-MODEL.md): membership checks, unread counts
// (`messages.createdAt > lastReadAt` and sender != me) and archive state are
// indexed row lookups instead of array/JSON scans. Unique on the pair, so a
// user can't be added to the same conversation twice.
model ConversationParticipant {
  id             String       @id @default(uuid(7))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadAt     DateTime?
  archivedAt     DateTime?
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, userId])
  @@index([userId, archivedAt])
}

// Body is 1-4000 chars trimmed, plain text only; a message needs a body or
// at least one attachment (application-enforced, DATA-MODEL.md). Edits
// aren't supported in the MVP so `editedAt` stays null. Delete is a soft
// delete by the sender within 15 minutes: `body` is blanked and `deletedAt`
// is set, and clients render "message deleted".
model Message {
  id             String       @id @default(uuid(7))
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body           String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attachments MessageAttachment[]

  @@index([conversationId, createdAt(sort: Desc), id])
}

// Replaces the standalone `Attachment` entity: reuses `Upload` (purpose
// `chat_attachment`) instead of duplicating storage metadata. `uploadId` is
// unique because an upload attaches to at most one message. `uploadId` is
// `Restrict` so an attached upload can't be deleted out from under a
// message; the uploader-must-be-sender and clean/processed checks are
// application-enforced at attach time (DATA-MODEL.md).
model MessageAttachment {
  id        String   @id @default(uuid(7))
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadId  String   @unique
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId])
}

// `location` is `geography(Point, 4326)`, an `Unsupported` type Prisma
// cannot index or write directly: the GiST index lives in hand-written
// migration SQL, like `Request`/`PhotographerProfile`. `photographerId`
// references `PhotographerProfile`, not `User`, like `Quote.photographerId`,
// so a booking survives the photographer's profile identity changing shape.
// Money is never duplicated here: the accepted `Quote`
// (subtotalCents/platformFeeCents/totalCents/currency) is the source of
// truth, read inside the same transaction that creates the `PaymentIntent`
// (1A.8c). The allowed `status` transitions are the table in
// packages/shared/src/booking-state-machine.ts, not enforced by the
// database. `Booking` rows are never hard-deleted (no `deletedAt`, no delete
// path), so `Restrict` on every child relation back to it is a safety net,
// not a real-world constraint.
model Booking {
  id                 String                                 @id @default(uuid(7))
  quoteId            String                                 @unique
  quote              Quote                                  @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  clientId           String
  client             User                                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  photographerId     String
  photographer       PhotographerProfile                    @relation(fields: [photographerId], references: [id], onDelete: Restrict)
  scheduledAt        DateTime
  location           Unsupported("geography(Point, 4326)")?
  status             BookingStatus                          @default(pending_payment)
  paymentIntentId    String?                                @unique
  chargeId           String?
  transferId         String?
  releaseDueAt       DateTime?
  deliveredAt        DateTime?
  releasedAt         DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt

  delivery      Delivery?
  ledgerEntries LedgerEntry[]
  disputes      Dispute[]

  @@index([clientId, createdAt])
  @@index([photographerId, createdAt])
  @@index([status, releaseDueAt])
  @@index([status, createdAt])
}

// One delivery per booking (`bookingId` unique): the photographer resubmits
// by replacing this row's message/files, not by adding a second delivery.
model Delivery {
  id           String    @id @default(uuid(7))
  bookingId    String    @unique
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  message      String
  externalLink String?
  deliveredAt  DateTime  @default(now())
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  files DeliveryFile[]
}

// Mirrors `MessageAttachment`/`VerificationDocument`: an `Upload` (purpose
// `delivery_file`) attaches to at most one delivery (`uploadId` unique),
// `Restrict` so a delivered file can't be deleted out from under the
// booking.
model DeliveryFile {
  id         String   @id @default(uuid(7))
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  uploadId   String   @unique
  upload     Upload   @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([deliveryId])
}

// Append-only: no `updatedAt`, no update or delete path anywhere (CLAUDE.md;
// like `AuditLog` and `ConsentRecord`). One row per money movement; the
// unique constraint on `(bookingId, type, stripeObjectId)` makes a replayed
// webhook a no-op at the database level, and a test asserts the ledger sums
// to zero against the charge for a completed booking (1A.8d).
model LedgerEntry {
  id             String          @id @default(uuid(7))
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type           LedgerEntryType
  amountCents    Int
  currency       String          @db.Char(3)
  stripeObjectId String
  occurredAt     DateTime        @default(now())

  @@unique([bookingId, type, stripeObjectId])
  @@index([bookingId])
}

// Idempotency store for the webhook (docs/PAYMENTS.md): `id` is the Stripe
// event id itself, not a generated uuid, and is inserted before the event is
// processed, in the same transaction as any state change it causes. A
// duplicate insert means "already handled"; the handler returns 200 without
// redoing the work. No `updatedAt`: `processedAt` is the only field ever set
// after insert, and only once, by the stuck-event sweep or the handler
// itself.
model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  payload     Json

  @@index([type, receivedAt])
  @@index([processedAt])
}

// `openedById` is required: a dispute is always opened by the cardholder on
// one side of a real booking, so it's always the booking's client, recorded
// by the webhook handler rather than left null. `status` is our own
// simplified lifecycle (`open` from `charge.dispute.created`, `won`/`lost`
// from `charge.dispute.closed`), not Stripe's full `dispute.status` enum; no
// automatic refund or reversal follows a dispute, a human decides
// (docs/PAYMENTS.md).
model Dispute {
  id                  String        @id @default(uuid(7))
  bookingId           String
  booking             Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  openedById          String
  openedBy            User          @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  reason              String
  status              DisputeStatus @default(open)
  resolution          String?
  adminId             String?
  admin               User?         @relation("DisputeAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  amountRefundedCents Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([bookingId])
  @@index([status, createdAt])
}

// Company data only, not a `PhotographerProfile` (docs/steps/1A.13-professionals.md):
// a professional role is added to the existing account (D13), never a
// second account. `verified` is a manual admin flag with no self-service
// path in this step. `vatNumber` is stored as given and never used for tax
// logic in Phase 1.
model ProfessionalProfile {
  id           String   @id @default(uuid(7))
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  website      String?
  vatNumber    String?
  logoUploadId String?  @unique
  logoUpload   Upload?  @relation("ProfessionalProfileLogo", fields: [logoUploadId], references: [id], onDelete: SetNull)
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobOffers JobOffer[]
}

// `location` is `geography(Point, 4326)`, an `Unsupported` type Prisma
// cannot index or write directly: the GiST index lives in hand-written
// migration SQL, same pattern as `PhotographerProfile`/`Request`
// (DATA-MODEL.md). A job offer's lifecycle is its listing's lifecycle
// (docs/steps/1A.13-professionals.md): publishing sets `publishedAt`,
// creates a `Listing` and sets `expiresAt` to the listing's; republishing an
// expired offer creates a *new* `Listing` rather than extending the old
// one, so `listingId` always points at the current listing. `deletedAt` is a
// moderator takedown (report-targets.ts), same soft-delete pattern as
// `PhotographerProfile`/`PortfolioImage`/`Request`; it is orthogonal to
// `status` — `closed` means the professional closed it themselves.
model JobOffer {
  id             String                                 @id @default(uuid(7))
  professionalId String
  professional   ProfessionalProfile                    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  slug           String                                 @unique
  title          String
  description    String
  category       PhotographerCategory
  location       Unsupported("geography(Point, 4326)")?
  city           String
  countryCode    String                                 @db.Char(2)
  country        Country                                @relation(fields: [countryCode], references: [code])
  remote         Boolean                                @default(false)
  startDate      DateTime?
  endDate        DateTime?
  compensation   Json?
  status         JobOfferStatus                         @default(draft)
  listingId      String?                                @unique
  listing        Listing?                               @relation(fields: [listingId], references: [id], onDelete: Restrict)
  publishedAt    DateTime?
  expiresAt      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime                               @default(now())
  updatedAt      DateTime                               @updatedAt

  applications JobApplication[]

  @@index([professionalId])
  @@index([status, publishedAt])
  @@index([countryCode, city])
}

// Unique on `(jobOfferId, photographerId)` so a double application is a
// database-level conflict (409), not a duplicate row
// (docs/steps/1A.13-professionals.md). Deleting the offer cascades to its
// applications; closing it (a status change) never touches them.
// `photographerId` is `Restrict`, like `Quote.photographerId`. `deletedAt` is
// a moderator takedown of the application itself (report-targets.ts), same
// soft-delete pattern as `PhotographerProfile`/`PortfolioImage`/`Request`.
model JobApplication {
  id             String               @id @default(uuid(7))
  jobOfferId     String
  jobOffer       JobOffer             @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  photographerId String
  photographer   PhotographerProfile  @relation(fields: [photographerId], references: [id], onDelete: Restrict)
  message        String
  portfolioLink  String?
  status         JobApplicationStatus @default(submitted)
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([jobOfferId, photographerId])
  @@index([jobOfferId, createdAt])
  @@index([photographerId, createdAt])
}

// `ownerId` is polymorphic (the id of the `JobOffer` for `kind = job_offer`),
// no foreign key, same pattern as `Report.targetType`/`targetId`
// (DATA-MODEL.md). `expiresAt` is indexed for the hourly `listing-expiry`
// sweep (docs/steps/1A.13-professionals.md). Free at launch (D8): the
// service refuses any `plan` but `free` in Phase 1, not only the schema.
model Listing {
  id                      String      @id @default(uuid(7))
  ownerId                 String
  kind                    ListingKind
  plan                    ListingPlan @default(free)
  priceCents              Int         @default(0)
  currency                String      @db.Char(3)
  paidAt                  DateTime?
  stripeCheckoutSessionId String?
  expiresAt               DateTime
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  jobOffer JobOffer?

  @@index([ownerId, kind])
  @@index([expiresAt])
}
