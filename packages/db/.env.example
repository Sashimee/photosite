DATABASE_URL=postgresql://photoo:photoo_dev_password@localhost:5432/photoo
TEST_DATABASE_URL=postgresql://photoo:photoo_dev_password@localhost:5432/photoo_test
SHADOW_DATABASE_URL=postgresql://photoo:photoo_dev_password@localhost:5432/photoo_shadow

# Dev-only password for the seed users (client@photoo.test, photographer@photoo.test,
# professional@photoo.test, admin@photoo.test). Never a real secret; hashed with
# Argon2id before being stored. Defaults to "correct-horse-battery-staple" if unset.
SEED_USER_PASSWORD=correct-horse-battery-staple

# Must match apps/api's VERIFICATION_ENCRYPTION_KEY so the API can decrypt what the
# seed encrypts. Dev-only value; falls back to it automatically outside production
# if unset. Generate a real one with: openssl rand -base64 32
VERIFICATION_ENCRYPTION_KEY=9DsORuh9HI1DUnXKM0DKVcgw36Y9NfbLBSlfPmQxwYs=

# Optional: when set, the seed uploads a placeholder JPEG to MinIO for every
# seeded photographer's avatar, cover and portfolio variant keys. Left unset,
# the seed logs a line and skips the upload so CI can still seed the DB.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=photoo_dev
S3_SECRET_ACCESS_KEY=photoo_dev_password
S3_FORCE_PATH_STYLE=true
S3_PRIVATE_BUCKET=photoo-private
S3_PUBLIC_BUCKET=photoo-public
