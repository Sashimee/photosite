{
  "name": "photosite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "pnpm --filter @photoo/i18n i18n:check",
    "mock:api": "docker run --rm -p 127.0.0.1:4010:4010 -v \"$PWD/packages/api-client/openapi.json:/contract/openapi.json:ro\" stoplight/prism:5.15.10 mock /contract/openapi.json --dynamic --host 0.0.0.0 --port 4010 --multiprocess false",
    "prepare": "husky",
    "stack:up": "docker compose -f infra/docker/compose.dev.yml up -d --wait postgres redis minio mailpit && docker compose -f infra/docker/compose.dev.yml run --rm minio-init && docker compose -f infra/docker/compose.dev.yml up -d clamav",
    "stack:down": "docker compose -f infra/docker/compose.dev.yml down",
    "stack:reset": "docker compose -f infra/docker/compose.dev.yml down -v",
    "db:seed": "pnpm --filter @photoo/db run seed",
    "test:integration": "set -a && . packages/db/.env && . apps/api/.env && set +a && pnpm exec turbo run test --filter=@photoo/db && pnpm --filter @photoo/worker build && pnpm --filter @photoo/api test && pnpm --filter @photoo/worker test",
    "typecheck:smoke": "tsc --noEmit -p tsconfig.json",
    "test:smoke": "playwright test --project=smoke-public --project=smoke-authenticated"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --flag v10_config_lookup_from_file --no-warn-ignored"
    ],
    "*.{json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@photoo/config": "workspace:*",
    "@photoo/shared": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "6.0.3"
  }
}
