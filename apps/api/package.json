  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@photoo/config": "workspace:*",
    "@photoo/worker": "workspace:*",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
