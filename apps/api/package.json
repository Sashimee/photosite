{
  "name": "@photoo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@better-auth/prisma-adapter": "1.7.10",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/websockets": "12.1.3",
    "@node-rs/argon2": "2.2.2",
    "@photoo/db": "workspace:*",
    "@photoo/email": "workspace:*",
    "@photoo/shared": "workspace:*",
    "@sentry/node": "10.75.0",
    "@socket.io/redis-adapter": "8.3.0",
    "better-auth": "1.7.10",
    "bullmq": "6.3.16",
    "dotenv": "17.4.2",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
