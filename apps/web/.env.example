NEXT_PUBLIC_API_URL=http://127.0.0.1:4010

# apps/web/e2e only (#316): the local stack's Redis, so the e2e harness can
# reset apps/api's per-IP auth rate limits between tests (support/rate-limit.ts).
# Not read by the app itself. pnpm stack:up's default.
REDIS_URL=redis://localhost:6379

# This app's own public origin, no trailing slash: drives metadataBase,
# canonical/hreflang URLs and JSON-LD. Required.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin (+ optional path prefix) that portfolio/avatar/cover images are
# served from (apps/api's S3_PUBLIC_BASE_URL). Unset blocks remote images
# (next.config.ts remotePatterns, lib/csp.ts img-src). Local stack default:
# http://localhost:9000/photoo-public
NEXT_PUBLIC_MEDIA_BASE_URL=

# Only needed when NEXT_PUBLIC_MEDIA_BASE_URL above is the local stack's
# MinIO (a private IP), which the image optimizer otherwise refuses to fetch
# from. Never set this anywhere that isn't a local MinIO.
ALLOW_LOCAL_IMAGE_HOSTS=false

# Defaults to off so any environment that forgets to set it stays noindexed.
# Only the literal string "true" enables indexing.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Sentry (docs/steps/human-followups.md): unset locally, the SDK is a no-op.
# Staging/production set SENTRY_REQUIRED=true so a missing DSN fails the build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_REQUIRED=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
