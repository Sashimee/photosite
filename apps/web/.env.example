NEXT_PUBLIC_API_URL=http://127.0.0.1:4010

# Defaults to off so any environment that forgets to set it stays noindexed.
# Only the literal string "true" enables indexing.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Sentry (docs/steps/human-followups.md): unset locally, the SDK is a no-op.
# Staging/production set SENTRY_REQUIRED=true so a missing DSN fails the build.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_REQUIRED=false
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
