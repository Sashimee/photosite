{
  "extends": "@photoo/config/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["DOM", "ES2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "customConditions": ["react-native"],
    "types": ["node", "expo/types"],
    "rootDir": "."
  },
  "include": ["app", "src", "jest", "*.config.ts", "app.config.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules"]
}
