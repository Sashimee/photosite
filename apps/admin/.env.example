NEXT_PUBLIC_API_URL=http://127.0.0.1:4010

# Unset locally and in production (admin.photoo.lu has its own subdomain).
# The preview host has no admin.* DNS record yet (docs/steps/human-followups.md),
# so it sets this to "/admin" and serves the app under a path prefix instead.
ADMIN_BASE_PATH=

# Shown on the health page. Unset locally, where "dev" and no build time
# are accurate; a future admin Dockerfile sets these at build time.
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_BUILD_TIME=

# Origin of apps/api's S3_ENDPOINT. Unset locally, where the API origin
# already covers it through a reverse proxy; a deployed environment whose
# storage lives on its own origin must set this or the verification
# document viewer's CSP connect-src blocks the presigned download.
NEXT_PUBLIC_STORAGE_ORIGIN=

# Origin (+ optional path prefix) that portfolio images are served from
# (apps/api's S3_PUBLIC_BASE_URL - apps/web reads the same value as
# NEXT_PUBLIC_MEDIA_BASE_URL). Unset blocks the moderation queue's
# portfolio-image preview (lib/csp.ts img-src). Local stack default:
# http://localhost:9000/photoo-public
NEXT_PUBLIC_MEDIA_BASE_URL=
