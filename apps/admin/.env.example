NEXT_PUBLIC_API_URL=http://127.0.0.1:4010

# Unset locally and in production (admin.photoo.lu has its own subdomain).
# The preview host has no admin.* DNS record yet (docs/steps/human-followups.md),
# so it sets this to "/admin" and serves the app under a path prefix instead.
ADMIN_BASE_PATH=

# Shown on the health page. Unset locally, where "dev" and no build time
# are accurate; a future admin Dockerfile sets these at build time.
NEXT_PUBLIC_BUILD_SHA=
NEXT_PUBLIC_BUILD_TIME=
