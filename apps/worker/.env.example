DATABASE_URL=postgresql://photoo:photoo_dev_password@localhost:5432/photoo
REDIS_URL=redis://localhost:6379
NODE_ENV=development
WEB_APP_URL=http://localhost:3000

HEALTH_PORT=4100

WORKER_CONCURRENCY_FILE_SCAN=2
WORKER_CONCURRENCY_IMAGE_PROCESS=2
WORKER_CONCURRENCY_UPLOADS_CLEANUP=1
UPLOADS_CLEANUP_INTERVAL_MS=600000
WORKER_CONCURRENCY_QUOTE_EXPIRY=1
QUOTE_EXPIRY_INTERVAL_MS=900000
IMAGE_PROCESS_MAX_PIXELS=100000000

S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=photoo_dev
S3_SECRET_ACCESS_KEY=photoo_dev_password
S3_FORCE_PATH_STYLE=true
S3_PRIVATE_BUCKET=photoo-private
S3_PUBLIC_BUCKET=photoo-public

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dev@photoo.lu

# Optional; push works without it, needed once the Expo account exists (0.6).
EXPO_ACCESS_TOKEN=

CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=30000
CLAMAV_MAX_SCAN_BYTES=26214400

WORKER_CONCURRENCY_EMAIL=3
WORKER_CONCURRENCY_NOTIFY=3
WORKER_CONCURRENCY_NOTIFY_SWEEP=1
WORKER_CONCURRENCY_PUSH_RECEIPTS=1
WORKER_CONCURRENCY_NOTIFICATIONS_CLEANUP=1
NOTIFY_SWEEP_INTERVAL_MS=300000
PUSH_RECEIPTS_INTERVAL_MS=900000
NOTIFICATIONS_CLEANUP_INTERVAL_MS=86400000
