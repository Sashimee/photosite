{
  "name": "@photoo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1132.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@photoo/db": "workspace:*",
    "@photoo/i18n": "workspace:*",
    "@photoo/shared": "workspace:*",
    "bullmq": "6.3.6",
    "dotenv": "17.4.2",
    "exifr": "7.1.3",
    "expo-server-sdk": "7.1.0",
    "file-type": "22.1.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.2.0",
    "nodemailer": "9.1.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.3",
    "@photoo/config": "workspace:*",
    "@types/node": "24.13.5",
    "@types/nodemailer": "8.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
