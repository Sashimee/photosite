{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@photoo/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CI", "TEST_DATABASE_URL", "SHADOW_DATABASE_URL", "REDIS_URL", "SEED_USER_PASSWORD"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
