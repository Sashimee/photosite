{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@photoo/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "CI",
        "TEST_DATABASE_URL",
        "SHADOW_DATABASE_URL",
        "REDIS_URL",
        "SEED_USER_PASSWORD",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_FORCE_PATH_STYLE",
        "S3_PRIVATE_BUCKET",
        "S3_PUBLIC_BUCKET",
        "S3_PUBLIC_BASE_URL",
        "CLAMAV_INTEGRATION_TEST"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
